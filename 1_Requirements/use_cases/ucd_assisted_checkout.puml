@startuml ucd_assisted_checkout
left to right direction
skinparam backgroundColor White
skinparam ArrowColor Black
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam actor {
  BackgroundColor White
  BorderColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam package {
  BackgroundColor White
  BorderColor Black
}
skinparam note {
  BackgroundColor White
  BorderColor Black
}
title Sub-diagram - Register and pay assisted purchases

actor Operator
actor Customer

rectangle "Item Registration and Payment System" {
  usecase "Register assisted purchase" as UC03
  usecase "Register item" as UC09
  usecase "Pay purchase" as UC10
}

Operator -- UC03
Customer -- UC03
UC03 ..> UC09 : <<include>>
UC03 ..> UC10 : <<include>>

note right of UC03
  Also used to register again a purchase sent
  from a validation with Unexplained
  Discrepancy (D4, D45).
end note
@enduml
